# Copy this file to `.streamlit/secrets.toml` (locally) or paste the same keys into
# Streamlit Cloud → App → Settings → Secrets. Never commit the real secrets.toml.
#
# Live data source for the deployed app (the sheet holds the five tabs
# SO_DO_Database, Collection, COGS_Database, Aging_Database, Stock_Database).
GOOGLE_SHEET_ID = "1Q9BiOVrf3-vKWfeoGVWB_mfRK1-gZvgy1bLu-z-j4bY"

# ---------------------------------------------------------------------------
# Private read access (recommended).
#
# Create a Google Cloud service account, enable the Google Sheets API, download
# its JSON key and paste the whole file below as one TOML table. Then share the
# Google Sheet with the service-account e-mail (Viewer) and REMOVE the
# "anyone with the link" access.
#
# Without this block the app falls back to the public CSV export, which only
# works while the sheet is shared with anyone who has the link.
# ---------------------------------------------------------------------------
#
# [gcp_service_account]
# type = "service_account"
# project_id = "nobayon-dashboard"
# private_key_id = "...."
# private_key = "-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"
# client_email = "dashboard-reader@nobayon-dashboard.iam.gserviceaccount.com"
# client_id = "...."
# token_uri = "https://oauth2.googleapis.com/token"
#
# Alternatively paste the JSON as a single string:
# SHEETS_CREDENTIALS = '{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
